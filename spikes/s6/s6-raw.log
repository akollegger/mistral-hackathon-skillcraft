    "id": "effect-0002e3dd-c256-5876-9cb8-4f3fc4aecde2",
    "sessionId": "79491ba5-d968-e4ec-407c-beed790eba6c",
    "turnId": "turn-b23a4921e2e9f48120a0c2a580e6eb92",
    "inputEntryId": "user-turn-b23a4921e2e9f48120a0c2a580e6eb92-1",
